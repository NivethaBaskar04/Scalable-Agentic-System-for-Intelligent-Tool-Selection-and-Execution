# ---- Retrieval / Ranking ----
TOP_K_TOOLS=5
TOP_K_DOMAIN_CANDIDATES=3
RETRIEVAL_CANDIDATE_K=15

# Ranking weights (should sum to ~1.0)
W_SEMANTIC=0.45
W_DOMAIN=0.20
W_PARAM=0.15
W_HISTORY=0.10
W_RELIABILITY=0.10

# ---- LLM Provider ----
# One of: mock | anthropic | openai
# If left as "mock" (or the chosen provider's key is missing), the app runs
# fully with a deterministic rule-based planner - no paid API required.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini

# ---- Execution ----
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.2
EXECUTION_TIMEOUT_SECONDS=5.0

# ---- RAG ----
RAG_TOP_K=3
